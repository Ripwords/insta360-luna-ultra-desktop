{
  "name": "luna-ultra-desktop",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tauri build",
    "dev": "tauri dev",
    "ui:dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "git config core.hooksPath .githooks || true && nuxt prepare",
    "test": "vitest run && vitest run -c vitest.nuxt.config.ts",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix --deny-warnings",
    "fmt": "oxfmt",
    "typecheck": "nuxt typecheck",
    "changelog": "changelogen",
    "release": "bun scripts/release.mjs"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.119",
    "@iconify-json/simple-icons": "^1.2.91",
    "@nuxt/ui": "^4.10.0",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-http": "^2.5.9",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "nuxt": "^4.5.0",
    "pannellum": "^2.5.7",
    "tailwindcss": "^4.3.3",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@nuxt/test-utils": "^4.0.3",
    "@tauri-apps/cli": "^2.11.4",
    "@types/three": "^0.185.1",
    "@vue/test-utils": "^2.4.11",
    "changelogen": "^0.6.2",
    "happy-dom": "^20.11.1",
    "lint-staged": "^17.2.0",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.8"
  },
  "lint-staged": {
    "**/*.{js,mjs,cjs,jsx,ts,mts,cts,tsx,vue}": [
      "oxfmt",
      "oxlint --fix --deny-warnings"
    ]
  }
}
